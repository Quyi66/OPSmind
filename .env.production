# 生产环境配置

# API 配置
VITE_API_BASE_URL=/sjxy-console
VITE_API_TIMEOUT=60000

# 服务端配置（统一入口）
VITE_BACKEND_URL=http://10.1.40.112:80

# 构建配置
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_OUTDIR=dist
VITE_BUILD_ASSETSDIR=assets

# 生产优化
VITE_BUILD_MINIFY=true
VITE_BUILD_TERSER=true
VITE_BUILD_GZIP=true
VITE_BUILD_PLUGIN_TIMINGS=false

# 调试配置
VITE_DEBUG=false
VITE_LOG_LEVEL=error
