+    
+    :deep(.el-tabs__content) {
+      flex: 1;
+      min-height: 0;
+      
+      .el-tab-pane {
+        height: 100%;
+      }
+    }
+  }
+}
+
+.upload-area {
+  padding: 10px 0;
