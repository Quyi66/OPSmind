+                  link
+                  type="primary"
+                  :loading="comparingId === row.id"
+                  @click="handleCompare(row)"
+                >
+                  开始比对
+                </el-button>
+                <el-button
+                  link
+                  type="success"
+                  :disabled="row.status === 'parsed'"
+                  @click="downloadFeedback(row)"
+                >
+                  导出反馈表
+                </el-button>
+                <el-button link type="danger" @click="handleDelete(row)">删除</el-button>
+              </template>
+            </el-table-column>
+          </el-table>
+        </div>
+
