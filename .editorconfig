# EditorConfig - 统一编辑器配置
# https://editorconfig.org

root = true

# 所有文件的默认配置
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 文件保留尾部空格（用于换行）
[*.md]
trim_trailing_whitespace = false

# Windows 批处理文件使用 CRLF
[*.{bat,cmd}]
end_of_line = crlf

# Makefile 使用 Tab
[Makefile]
indent_style = tab
