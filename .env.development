# 开发环境配置
NODE_ENV=development

# API 配置
VITE_API_BASE_URL=/oplus-portal
VITE_API_TIMEOUT=10000

# 服务端配置（统一入口）
VITE_ANGULAR_URL=http://localhost:8080
VITE_BACKEND_URL=http://localhost:18080
VITE_DTS_API_PREFIX=/dts/api/dts

# 开发服务器配置
VITE_DEV_PORT=5173
VITE_DEV_HOST=0.0.0.0
VITE_DEV_OPEN=true
VITE_DEV_CORS=true

# 调试配置
VITE_DEBUG=true
VITE_LOG_LEVEL=info
