{
  "name": "opsmind-dashboard-vue",
  "version": "1.0.0",
  "description": "OpsMind Vue 3 Dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --config build/vite.config.dev.js",
    "dev:host": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production --config build/vite.config.prod.js",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist/stats.html",
    "preview": "vite preview",
    "preview:build": "npm run build && vite preview",
    "preview:prod": "npm run build:prod && vite preview --port 4173",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:staged": "lint-staged",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rimraf dist node_modules/.vite node_modules/.cache",
    "clean:all": "rimraf dist node_modules package-lock.json",
    "clean:deps": "rimraf node_modules package-lock.json && npm install",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.4.4",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.21.0",
    "@eslint/object-schema": "^2.1.6",
    "@rushstack/eslint-patch": "^1.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^9.19.2",
    "glob": "^11.0.3",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass-embedded": "^1.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
