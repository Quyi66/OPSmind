{
  "name": "opsmind-dashboard-vue",
  "version": "1.0.0",
  "description": "OPSmind Vue 3 Dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist/stats.html",
    "preview": "vite preview",
    "preview:build": "npm run build && vite preview",
    "preview:prod": "npm run build:prod && vite preview --port 4173",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:staged": "lint-staged",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rimraf dist node_modules/.vite node_modules/.cache",
    "clean:all": "rimraf dist node_modules package-lock.json",
    "clean:deps": "rimraf node_modules package-lock.json && npm install",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "bpmn-js": "^18.21.0",
    "bpmn-js-token-simulation": "^0.40.0",
    "codemirror": "^6.0.2",
    "crypto-js": "^4.2.0",
    "diagram-js-minimap": "^5.4.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "mammoth": "^1.12.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-codemirror": "^6.1.1",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@iconify-json/ep": "^1.2.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^9.19.2",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
