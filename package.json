{
  "name": "opsmind-dashboard-vue",
  "version": "1.0.0",
  "description": "OPSmind Vue 3 Dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist/stats.html",
    "preview": "vite preview",
    "preview:build": "npm run build && vite preview",
    "preview:prod": "npm run build:prod && vite preview --port 4173",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:staged": "lint-staged",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rimraf dist node_modules/.vite node_modules/.cache",
    "clean:all": "rimraf dist node_modules package-lock.json",
    "clean:deps": "rimraf node_modules package-lock.json && npm install",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@vue-js-cron/element-plus": "^3.1.10",
    "axios": "^1.13.2",
    "bpmn-js": "^18.9.1",
    "codemirror": "^6.0.2",
    "crypto-js": "^4.2.0",
    "diff2html": "^3.4.52",
    "echarts": "^6.0.0",
    "element-plus": "^2.12.0",
    "mammoth": "^1.11.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-codemirror": "^6.1.1",
    "vue-demi": "^0.14.10",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.21.0",
    "@eslint/object-schema": "^2.1.6",
    "@rushstack/eslint-patch": "^1.6.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.0.15",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^9.19.2",
    "glob": "^11.0.3",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass-embedded": "^1.90.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.8"
  }
}
